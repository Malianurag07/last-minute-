{
  "name": "lastminute-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LastMinute API: the single source of truth for accounts, shops, orders and admin actions.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "NODE_ENV=development node --watch --disable-warning=ExperimentalWarning src/index.ts",
    "test": "NODE_ENV=test node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "keys": "node --disable-warning=ExperimentalWarning src/tools/gen-keys.ts",
    "admin:create": "node --disable-warning=ExperimentalWarning src/tools/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
